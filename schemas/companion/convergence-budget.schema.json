{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Convergence Budget v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item_id",
    "assurance_mode",
    "initial_audit_limit",
    "repair_batch_limit",
    "final_audit_limit",
    "initial_audits_used",
    "repair_batches_used",
    "final_audits_used",
    "status",
    "updated_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_item_id": {
      "type": "string"
    },
    "assurance_mode": {
      "enum": [
        "flow",
        "guarded",
        "release"
      ]
    },
    "initial_audit_limit": {
      "type": "integer",
      "minimum": 0
    },
    "repair_batch_limit": {
      "type": "integer",
      "minimum": 0
    },
    "final_audit_limit": {
      "type": "integer",
      "minimum": 0
    },
    "initial_audits_used": {
      "type": "integer",
      "minimum": 0
    },
    "repair_batches_used": {
      "type": "integer",
      "minimum": 0
    },
    "final_audits_used": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "available",
        "exhausted",
        "closed"
      ]
    },
    "updated_at_utc": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
