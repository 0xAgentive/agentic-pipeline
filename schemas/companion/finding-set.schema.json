{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item_id",
    "target_head",
    "findings",
    "updated_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_item_id": {
      "type": "string"
    },
    "target_head": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.schema.json"
      }
    },
    "updated_at_utc": {
      "type": "string"
    }
  }
}
