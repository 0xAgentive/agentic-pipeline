      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "work_item_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "route": {
      "type": [
        "string",
        "null"
      ]
    },
    "auto_continue": {
      "type": "boolean"
    },
    "owner_decision_required": {
      "type": "boolean"
    },
    "owner_decision_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "technical_task_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at_utc": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
