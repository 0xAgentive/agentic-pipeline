{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repair Delta v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item_id",
    "batch_id",
    "finding_ids",
    "scope_paths",
    "verification_required",
    "status",
    "generated_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "pattern": "^RB-[0-9]{3}$"
    },
    "finding_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scope_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "verification_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "ready",
        "active",
        "verification",
        "completed",
        "blocked"
      ]
    },
    "generated_at_utc": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
