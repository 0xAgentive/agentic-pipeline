{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item_id",
    "goal_epoch",
    "branch",
    "head",
    "execution_lease_id",
    "candidate_manifest_sha256",
    "completed_at_utc",
    "changed_files",
    "tests",
    "evidence_artifacts",
    "product_artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1
    },
    "goal_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "execution_lease_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completed_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\\\\\r\\n<>:\"|?*]+$"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "required",
          "exit_code",
          "completed_at_utc",
          "evidence_path",
          "evidence_sha256",
          "evidence_size_bytes"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "required": {
            "type": "boolean"
          },
          "exit_code": {
            "type": "integer"
          },
          "started_at_utc": {
            "type": "string",
            "minLength": 1
          },
          "completed_at_utc": {
            "type": "string",
            "minLength": 1
          },
          "evidence_path": {
            "type": "string",
            "pattern": "^\\.agy/verification/(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\\\\\r\\n<>:\"|?*]+$"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "supersedes_run_id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "evidence_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\\\\\r\\n<>:\"|?*]+$"
      }
    },
    "product_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\\\\\r\\n<>:\"|?*]+$"
      }
    }
  }
}
